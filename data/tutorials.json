    {
     "kind": "freeze",
     "target": "fish.bobber",
     "text": "톡톡! 아직이에요. 물고기가 **간만 보는 중**이에요.",
     "expr": "surprised",
     "until": "tap"
    },
    {
     "kind": "wait",
     "target": "fish.bobber",
     "text": "진짜로 물면 찌가 **쑥** 들어가요.",
     "expr": "neutral",
     "until": "event:bite"
    },
    {
     "kind": "freeze",
     "target": "fish.bobber",
     "text": "지금이에요! **쑥** 들어갔어요! {탭}",
     "expr": "surprised",
     "until": "input:hook"
    }
   ]
  },
