     "autumn"
    ]
   },
   "once": false,
   "prio": 2
  },
  {
   "id": "gull_17",
   "npc": "gull",
   "text": "겨울엔 먹이 얼지 않게 품에 안고 다닙니다. 따뜻해요.",
