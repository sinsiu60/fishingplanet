    "phantom_print": true,
    "phantom_tutorial": true
   },
   "once": true,
   "prio": 3
  },
  {
   "id": "gull_07",
   "npc": "gull",
   "text": "도감 별이 쌓이는군요. 별을 세는 것도 학문이지요!",
