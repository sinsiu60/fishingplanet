    "season": [
     "spring"
    ]
   },
   "once": false,
   "prio": 2
  },
  {
   "id": "gull_10",
   "npc": "gull",
   "text": "봄 갈매기는 노래가 다릅니다. 저만 아는 사실이지요.",
